# App
# Local: http://localhost:3000
# Production: https://elevate-healthsolutions.com (hyphenated; no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional SEO/sitemap override; defaults to NEXT_PUBLIC_APP_URL / production apex
# NEXT_PUBLIC_SITE_URL=https://elevate-healthsolutions.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Mux
MUX_TOKEN_ID=your-mux-token-id
MUX_TOKEN_SECRET=your-mux-token-secret
MUX_SIGNING_KEY_ID=your-mux-signing-key-id
MUX_SIGNING_PRIVATE_KEY=your-mux-signing-private-key
MUX_WEBHOOK_SECRET=your-mux-webhook-secret

# Email (transactional only — no marketing lists)
RESEND_API_KEY=re_your_key
TRANSACTIONAL_EMAIL_FROM=Elevate Health Solutions <hello@your-verified-domain>
TRANSACTIONAL_EMAIL_REPLY_TO=support@your-verified-domain
# Server-only recipient for new enquiry admin notifications (do not expose to client).
# Optional locally: missing value skips admin email and still saves the enquiry.
# CLIENT EMAIL ADDRESS REQUIRED before production notifications are useful.
ENQUIRY_NOTIFICATION_TO=
EMAIL_DELIVERY_ENABLED=false
EMAIL_REQUIRE_ALLOWLIST=true
EMAIL_TEST_RECIPIENT_ALLOWLIST=
EMAIL_ALLOW_RESEND_DEV_FROM=false
# EMAIL_OUTBOX_BATCH_SIZE=10
# EMAIL_OUTBOX_MAX_ATTEMPTS=8

# CRM
GHL_API_KEY=your-ghl-api-key

# Kit (marketing lists only — transactional email stays on Resend)
# Disabled by default. Enable only in production after KIT_API_KEY is configured.
KIT_API_KEY=
KIT_SYNC_ENABLED=false
# Newsletter opt-in form ID from Kit (audit: "Newsletter site" = 9811927)
KIT_NEWSLETTER_FORM_ID=9811927
# KIT_REQUEST_TIMEOUT_MS=8000
# KIT_CONSENT_SYNC_BATCH_SIZE=25

# Cron
CRON_SECRET=your-cron-secret

# Development — set to "true" to skip env validation locally
# SKIP_ENV_VALIDATION=true
